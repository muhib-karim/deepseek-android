<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:text="@string/widget_empty" android:textColor="#FF182640"
        android:textSize="14sp" android:maxLines="2" android:ellipsize="end" android:gravity="center_vertical" />
    <TextView android:id="@+id/widget_ask" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:paddingHorizontal="12dp" android:gravity="center_vertical"
        android:background="@drawable/widget_field" android:text="@string/widget_ask"
        android:textColor="#FF305DA8" android:textSize="18sp" android:clickable="true" android:focusable="true" />
    <Button android:id="@+id/widget_voice" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:text="@string/voice_mode" android:textColor="#FF305DA8"
        android:textSize="14sp" android:background="@drawable/widget_field" android:layout_marginTop="8dp" />
</LinearLayout>
