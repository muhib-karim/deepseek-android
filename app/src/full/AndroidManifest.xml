<?xml version="1.0" encoding="utf-8"?>
<!--
  Full build: runs DeepSeek's own agent harness (dsh) on a bundled Node runtime, the dsh-android way.
  The harness is a long-running local process, so it lives in a data-sync foreground service with a notification
  (FOREGROUND_SERVICE, FOREGROUND_SERVICE_DATA_SYNC, POST_NOTIFICATIONS) and holds a wake lock while a turn runs.
  No root, shell-storage or install permissions; nothing is mirrored to shared storage.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- API 28 target: READ_EXTERNAL_STORAGE (runtime, asked at use) still grants photo access on newer Android. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:remove="android:maxSdkVersion" />
    <application>
        <!-- The official DeepSeek engine: the dsh web UI in a WebView over the local harness. Not exported. -->
        <activity android:name=".engine.EngineActivity" android:exported="false" android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density"
            android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.DsAndroid" />
        <service android:name=".engine.NodeServer" android:exported="false" android:foregroundServiceType="dataSync" />
        <!-- Hands harness files (downloads, shares) to other apps one URI at a time. -->
        <provider android:name=".engine.FileBridge" android:authorities="${applicationId}.engine.files"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
