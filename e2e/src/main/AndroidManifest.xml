<?xml version="1.0" encoding="utf-8"?>
<!-- Test-only host for the release E2E driver. No activity, no permission; it shares fixture files with the app under test. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="app.dsandroid" />
    </queries>
    <application android:label="DeepSeek Android E2E" android:allowBackup="false">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="app.dsandroid.e2e.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/e2e_files" />
        </provider>
    </application>
</manifest>
