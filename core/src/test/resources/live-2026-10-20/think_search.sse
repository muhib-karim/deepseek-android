data: {"p":"response/fragments/-1/results","o":"SET","v":[{"url":"https://spacepolicyonline.com/news/whats-happening-in-space-policy-october-18-24-2026/","title":"What’s Happening in Space Policy October 18-24, 2026","snippet":"Tuesday-Wednesday, October 20-21 ... Wednesday, October 21 - Human Exploration Across the Moon: Report Release (National Academies), virtual, 1:00-2:30 pm ET Wednesday-Friday, October 21-23","cite_index":null,"published_at":1792252800.0,"site_icon":"https://cdn.deepseek.com/site-icons/spacepolicyonline.com","site_name":"Space Policy Online","query_indexes":[0],"provider":null},{"url":"https://www.tomorrowsworldtoday.com/space/nasa-prepares-for-spacewalks-advanced-biomedical-research/","title":"NASA Prepares for Spacewalks & Advanced Biomedical Research","snippet":"2026年10月21日星期三 # NASA Prepares for Spacewalks & Advanced Biomedical Research Astronauts will install new solar arrays on the ISS and explore personalized treatments in space. Preparations for upcoming spacewalks kicked off this week aboard the International Space Station, with two ... the end of October.","cite_index":null,"published_at":1792425600.0,"site_icon":"https://cdn.deepseek.com/site-icons/tomorrowsworldtoday.com","site_name":"Tomorrow's World Today","query_indexes":[0],"provider":null},{"url":"https://www.ecoticias.com/en/nasa-released-footage-of-astronauts-testing-lunar-outposts-pegasus-as-robotic-rovers-and-lunar-terrain-vehicles-get-ready-to-scout-the-moons-south-pole-and-each-ltv-will-cover-up-to-3-7-miles-a-day/52598/","title":"NASA released footage of astronauts testing Lunar Outpost's Pegasus as robotic rovers and lunar terrain vehicles get ready to scout the Moon's South Pole, and each LTV will cover up to 3.7 miles a day","snippet":"NASA released footage of astronauts testing Lunar Outpost’s Pegasus as robotic rovers and lunar terrain vehicles get ready to scout the Moon’s South Pole ... NASA on October 20 ... released a progress update on the rovers that will open its Moon Base...","cite_index":null,"published_at":1792425600.0,"site_icon":"https://cdn.deepseek.com/site-icons/ecoticias.com","site_name":"ECOticias.com El Periódico Verde","query_indexes":[0],"provider":null},{"url":"https://manager.bg/%d1%81%d0%b2%d1%8f%d1%82/kanadec-i-amrikanec-izlizat-v-otkritia-kosmos-za-da-obnovat-slanchevite-paneli-na-mks","title":"Канадец и амриканец излизат в открития космос, за да обновят слънчевите панели на МКС","snippet":"Астронавтите на борда на Международната космическа станция (МКС) ще извършат излизане в открития космос на 29 октомври и 5 ноември, за да обновят енергийната система на орбиталната лаборатория, обяви NASA.","cite_index":null,"published_at":1792425600.0,"site_icon":"https://cdn.deepseek.com/site-icons/manager.bg","site_name":"manager.bg","query_indexes":[0],"provider":null},{"url":"https://keeptrack.space/space-brief/space-brief-2026-10-18","title":"Orionid Meteor Shower Peaks October 21-22","snippet":"Orionid Meteor Shower Peaks October 21-22 The Orionids peak October 21-22 with 10 to 20 meteors per hour from Halley's Comet debris. ... NASA Converts the Eagle Nebula Pillars Into Sound","cite_index":null,"published_at":1792252800.0,"site_icon":"https://cdn.deepseek.com/site-icons/keeptrack.space","site_name":"KeepTrack","query_indexes":[0],"provider":null},{"url":"https://isstracker.pl/news/przygotowania-do-spacerow-kosmicznych-i-zaawansowane-badania-biomedyczne-rozpoczynaja-tydzien,446zM7","title":"Przygotowania do spacerów kosmicznych i zaawansowane badania biomedyczne rozpoczynają tydzień • ISS Tracker","snippet":"Kierownictwo NASA omówi zbliżające się spacery podczas konferencji w Centrum Lotów Kosmicznych Johnsona, o godzinie 14:00 czasu wschodniego we wtorek 20 października.","cite_index":null,"published_at":1792425600.0,"site_icon":"https://cdn.deepseek.com/site-icons/isstracker.pl","site_name":"isstracker.pl","query_indexes":[0],"provider":null},{"url":"https://technews.tw/2026/10/17/nasa-roman-space-telescope-initial-optical-test-successful/?utm_source=fb_tn&utm_medium=facebook","title":"精度堪比「240 公里外打硬幣」，NASA 羅曼太空望遠鏡超高穩定度通過關鍵測試","snippet":"根據 NASA 公布的最新資訊，工程團隊於 9 月 15 日至 21 日期間順利測試其「精細導引系統」，確認望遠鏡能持續精準鎖定同一片天空，穩定度正式達到科學觀測所需的高標準。","cite_index":null,"published_at":1792166400.0,"site_icon":"https://cdn.deepseek.com/site-icons/technews.tw","site_name":"TechNews 科技新報","query_indexes":[0],"provider":null},{"url":"https://www.publicnow.com/view/98980A063D4E284EC5D41B6D8D1A9C3561A6E0A6","title":"NASA - The National Aeronautics and Space[...] (via Public) / Two NASA Commercial Satellite Communication Demonstrations Launch","snippet":"Two NASA Commercial Satellite Communication Demonstrations Launch ... Two NASA-funded demonstrations have successfully launched into low Earth orbit aboard the SpaceX Bandwagon-5 rideshare. Over the coming weeks ... After Tuesday's launch, two of NASA's partners, Viasat and SES Space and Defense, will prepare to test high- and low-rate communications capabilities for the agency.","cite_index":null,"published_at":null,"site_icon":"https://cdn.deepseek.com/site-icons/publicnow.com","site_name":"Public now","query_indexes":[0],"provider":null},{"url":"https://havadiskolik.com/teknoloji/nasa-minyatur-insan-beyinlerini-uzayda-inceleyecek/","title":"NASA, minyatür insan beyinlerini uzayda inceleyecek","snippet":"ABONE OL Ekim 20, 2026 14:22  News  Uzay koşullarının insan beynini nasıl etkilediğini anlamayı amaçlayan yeni bir araştırma kapsamında, laboratuvarda yetiştirilen minyatür insan beyni modelleri Ulusl","cite_index":null,"published_at":1792425600.0,"site_icon":"https://cdn.deepseek.com/site-icons/havadiskolik.com","site_name":"Havadiskolik","query_indexes":[0],"provider":null},{"url":"https://misskey.virtualrocketwatching.net/notes/as5ozyh7n8","title":"Guppy@ロケみる集会 (@guppy0228)","snippet":"# ロケット打ち上げを観る集会  VRChatでロケットの打ち上げ生中継・アーカイブ動画を同時視聴する、パブリックビューイングイベントを行っています。実物大の3Dモデルや教材を用いて、最新の宇宙開発事情をお届けします。 ホームページ→ https://virtualrocketwatching.net/  用户  22  帖子  110,083  看看时间线  bot  @guppy0228  b","cite_index":null,"published_at":1791561600.0,"site_icon":"https://cdn.deepseek.com/site-icons/virtualrocketwatching.net","site_name":"renter | ロケット打ち上げを観る集会","query_indexes":[0],"provider":null},{"url":"https://globalnews.ca/video/11892616/nasa-reverses-evacuation-alert-order-for-astronauts-aboard-international-space-station/","title":"NASA reverses evacuation alert order for astronauts aboard International Space Station | Watch News Videos Online","snippet":"NASA reverses evacuation alert order for astronauts aboard International Space Station Description 14 minutes ago Astronauts on board the International Space Station have now been told by NASA to “end the safe haven procedures and return to planned operations aboard the International Space Station.” Nathaniel Dove has the latest.","cite_index":null,"published_at":null,"site_icon":"https://cdn.deepseek.com/site-icons/globalnews.ca","site_name":"Global News","query_indexes":[0],"provider":null},{"url":"https://www.wafb.com/news/national/www.wafb.com/#main","title":"National","snippet":"A 22-year-old NASA observatory is expected to reenter Earth's atmosphere in the coming weeks. ... NASA and SpaceX launched Crew-13 to the International Space Station, led by commander Jessica Watkins and carrying a Canadian astronaut set to become a father in orbit.","cite_index":null,"published_at":null,"site_icon":"https://cdn.deepseek.com/site-icons/wafb.com","site_name":"WAFB","query_indexes":[0],"provider":null},{"url":"https://www.firstalert4.com/news/national/Woman-sentenced-to-80-years-for-day-care-fire-that-killed-4-children-180190231.html?c=y&c=y&c=y&c=y&gallery=y&img=4","title":"National","snippet":"National Updated: 17 minutes ago By The Associated Press and Marcia Dunn NASA is racing to save an aging telescope from falling back to Earth with a daring rescue mission. Updated: 2 hours ago ... Astronomers have uncovered a pair of giant planets that are lighter than cotton candy. Updated: 9 hours ago","cite_index":null,"published_at":null,"site_icon":"https://cdn.deepseek.com/site-icons/firstalert4.com","site_name":"KMOV","query_indexes":[0],"provider":null},{"url":"https://botasot.co/no/tag/nasa/","title":"NASA - World Today News 🌐","snippet":"NASA deler bilder fra verdensrommet av orkanen Milton som traff Florida ... NASA ... NASA oppdager den lyseste kosmiske eksplosjonen som noen gang er registrert ... NASA oppdager 'superjorden' eksoplanet i beboelig sone","cite_index":null,"published_at":null,"site_icon":"https://cdn.deepseek.com/site-icons/botasot.co","site_name":"Bota Sot News 🌐","query_indexes":[0],"provider":null},{"url":"https://newsweek.ro/actualitate/astronaut-nasa-speriat-de-moarte-la-406000-km-de-pamant-nu-ne-vom-mai-intoarce-acasa","title":"Astronaut NASA, speriat de moarte la 406.000 km de Pământ: „Nu ne vom mai întoarce acasă” • Newsweek România","snippet":"Astronaut NASA, speriat de moarte la 406.000 km de Pământ: „Nu ne vom mai întoarce acasă” ... Astronaut NASA, speriat de moarte la peste 406.000 km de Pământ...","cite_index":null,"published_at":1792425600.0,"site_icon":"https://cdn.deepseek.com/site-icons/newsweek.ro","site_name":"Newsweek Romania","query_indexes":[0],"provider":null},{"url":"https://botasot.co/es/tag/nasa/","title":"NASA - Noticias del Mundo Hoy 🌐","snippet":"La NASA comparte fotos desde el espacio del huracán Milton que azotó Florida ... NASA ... 2 Minutos ### La NASA descubre la explosión cósmica más brillante jamás registrada ... La NASA descubre un exoplaneta 'supertierra' en zona habitable","cite_index":null,"published_at":null,"site_icon":"https://cdn.deepseek.com/site-icons/botasot.co","site_name":"Bota Sot News 🌐","query_indexes":[0],"provider":null},{"url":"https://flipboard.com/@pablorodreguez/fabric-of-the-universe-1859oe53z/nasa-s-sr-1-freedom-advances-with-progress-on-nuclear-power-module---nasa/a-r1btP5X_S1uUJrQPlgmojQ%3Aa%3A3256150430-bff61ba261%2Fnasa.gov","title":"NASA’s SR-1 Freedom Ad